def review(tag, cams=("front","side","q34"), silhouette=True, out=None):
    """Clay + silhouette renders of the current pose. The silhouette pass is not
    decoration: a pose that does not read as a solid black shape at thumbnail
    size will not read on a phone mid-fight."""
    import os
    out = out or REVIEW_DIR
    os.makedirs(out, exist_ok=True)
    sc = bpy.context.scene
    sav = dict(engine=sc.render.engine, cam=sc.camera, rx=sc.render.resolution_x,
               ry=sc.render.resolution_y, fp=sc.render.filepath)
    sh  = sc.display.shading
    shs = (sh.light, sh.color_type, tuple(sh.single_color), sh.show_cavity)
    lc  = bpy.context.view_layer.layer_collection.children.get("Yemoja")
    src = lc.children.get("Yemoja_Source") if lc else None
    if src: src.exclude = True
    sc.render.engine = "BLENDER_WORKBENCH"
    paths = []
    sh.light="STUDIO"; sh.color_type="SINGLE"; sh.single_color=(0.62,0.63,0.66); sh.show_cavity=True
    sc.render.resolution_x, sc.render.resolution_y = 800, 1100
    for n in cams:
        sc.camera = bpy.data.objects["_AR_"+n]
        p = os.path.join(out, "%s_%s.png" % (tag, n)); sc.render.filepath = p
        bpy.ops.render.render(write_still=True); paths.append(p)
    if silhouette:
        sh.light="FLAT"; sh.color_type="SINGLE"; sh.single_color=(0,0,0); sh.show_cavity=False
        sc.render.resolution_x, sc.render.resolution_y = 300, 412
        for n in cams:
            sc.camera = bpy.data.objects["_AR_"+n]
            p = os.path.join(out, "%s_sil_%s.png" % (tag, n)); sc.render.filepath = p
            bpy.ops.render.render(write_still=True); paths.append(p)
    sh.light, sh.color_type, sh.single_color, sh.show_cavity = shs
    if src: src.exclude = False
    sc.render.engine=sav["engine"]; sc.camera=sav["cam"]
    sc.render.resolution_x, sc.render.resolution_y = sav["rx"], sav["ry"]
    sc.render.filepath = sav["fp"]
    return paths


# --------------------------------------------------- capturing a hand-posed grip ---
# The analytic grip solver gets close but a human eye closes the last gap. Pose the
# right hand's fingers in the viewport, then call capture_grip() -- it reads the
# rotations straight off the rig and writes them into this file as CAPTURED_GRIP_R,
# so the same grip is reused by every clip from then on.
CAPTURED_GRIP_R = None      # filled in by capture_grip()

def _finger_bones(side="R"):
    out=[]
    for f in ("Thumb","Index","Middle","Ring","Pinky"):
        for j in (1,2,3):
            n = "%sHand%s%d.%s" % (PFX, f, j, side)
            if n in armature().pose.bones: out.append(n)
    return out

def capture_grip(side="R", write=True):
    """Read the current finger pose and (by default) persist it into this file."""
    A = armature()
    data = {}
    for n in _finger_bones(side):
        q = A.pose.bones[n].matrix_basis.to_quaternion()
        data[n] = (round(q.w,6), round(q.x,6), round(q.y,6), round(q.z,6))
    if write:
        import re, io
        p = __file__
        src = open(p, encoding="utf-8").read()
        block = "CAPTURED_GRIP_R = " + repr(data)
        src = re.sub(r"CAPTURED_GRIP_R = .*", block, src, count=1)
        open(p, "w", encoding="utf-8").write(src)
    return data

def apply_captured_grip(side="R"):
    """Re-apply the hand-authored grip. Falls back to the solved GRIP_HAND."""
    from mathutils import Quaternion
    A = armature()
    src = CAPTURED_GRIP_R if side == "R" else None
    if not src:
        hand_shape(side, **GRIP_HAND); return False
    for n, q in src.items():
        if n in A.pose.bones:
            A.pose.bones[n].rotation_quaternion = Quaternion(q)
            A.pose.bones[n].matrix_basis = Quaternion(q).to_matrix().to_4x4()
    bpy.context.view_layer.update()
    return True

def setup_for_grip_editing():
    """Put Blender in the right state to hand-tune the grip: pose mode, only the
    right-hand finger bones selected, everything else deselected."""
    A = armature()
    for ob in bpy.context.selected_objects: ob.select_set(False)
    A.select_set(True)
    bpy.context.view_layer.objects.active = A
    if bpy.context.object.mode != "POSE":
        bpy.ops.object.mode_set(mode="POSE")
    # Blender 5.x moved bone selection onto PoseBone, not Bone
    for pb in A.pose.bones:
        pb.select = False
        pb.bone.hide = False
    names = _finger_bones("R")
    for n in names:
        A.pose.bones[n].select = True
    try:
        A.data.bones.active = A.data.bones[names[3]]
    except Exception:
        pass
    return names


# ---------------------------------------------------- weight smoothing at a joint ---
# This rig has NO twist bones, so all forearm pronation lands on one joint and the
# skin folds ("candy wrapper"). The fix is not to move the rotation -- measured, that
# only relocates the damage -- but to hand the weights over more gradually and to
# centre the handover ON the joint. Measured on the idle master pose:
#   ForeArm.L 0.856 -> 0.962,  Arm.L 0.921 -> 0.970,  Hand.L 0.911 -> 0.936
# Half-widths that won the search: wrist 0.22, elbow 0.18 (in child-bone lengths).
def smooth_joint_weights(parent, child, half=0.20, objname="Yemoja_Body"):
    """Redistribute weight between parent and child across a smoothstep ramp
    centred on the joint. Only these two bones are touched and each vertex's total
    weight is preserved, so nothing else in the weighting is disturbed."""
    A = armature(); ob = bpy.data.objects[objname]
    gn = {g.index: g.name for g in ob.vertex_groups}
    to_arm = A.matrix_world.inverted() @ ob.matrix_world
    cb = A.data.bones[full(child)]
    origin = cb.head_local
    axis = (cb.tail_local - cb.head_local).normalized()
    ln = (cb.tail_local - cb.head_local).length
    gp, gc = ob.vertex_groups[full(parent)], ob.vertex_groups[full(child)]
    n = 0
    for v in ob.data.vertices:
        w = {gn[ge.group]: ge.weight for ge in v.groups if gn[ge.group].startswith(PFX)}
        tot = w.get(full(parent), 0.0) + w.get(full(child), 0.0)
        if tot < 0.5: continue
        s = ((to_arm @ v.co) - origin).dot(axis) / ln
        t = min(1.0, max(0.0, (s + half) / (2 * half)))
        f = t * t * (3 - 2 * t)
        gc.add([v.index], tot * f, "REPLACE")
        gp.add([v.index], tot * (1.0 - f), "REPLACE")
        n += 1
    return n

def normalise_weights(objname="Yemoja_Body", max_influences=4):
    """Enforce the export rule: at most 4 bone influences per vertex, summing to 1.0.
    Blender normalises internally at deform time so unnormalised weights look fine
    here and deform DIFFERENTLY in Unity, which clamps to 4 first."""
    ob = bpy.data.objects[objname]
    gn = {g.index: g.name for g in ob.vertex_groups}
    capped = 0
    for v in ob.data.vertices:
        ges = [ge for ge in v.groups if gn[ge.group].startswith(PFX) and ge.weight > 1e-5]
        if len(ges) > max_influences:
            ges.sort(key=lambda ge: -ge.weight)
            for ge in ges[max_influences:]:
                ob.vertex_groups[gn[ge.group]].remove([v.index])
            ges = ges[:max_influences]; capped += 1
        tot = sum(ge.weight for ge in ges)
        if ges and abs(tot - 1.0) > 1e-4:
            for ge in ges:
                ob.vertex_groups[gn[ge.group]].add([v.index], ge.weight / tot, "REPLACE")
    return capped

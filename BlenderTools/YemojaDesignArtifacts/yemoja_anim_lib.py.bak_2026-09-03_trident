# ----------------------------------------------------- animation preview mode ---
# Yemoja_Scalp and Yemoja_Tattoos each carry a Shrinkwrap BEFORE their Armature
# modifier, targeting the EVALUATED Yemoja_Body. In rest pose that is correct.
# Posed, the scalp is still in rest space but is projected onto a body that has
# moved, so Locs_Generator rebuilds the locs off the wrong surface: MEASURED at
# -23.1% total loc length on a fight stance (0.00% with the modifier off).
# Viewport artifact only -- the export applies both in rest pose -- but you
# cannot judge a pose from a render that is lying.
_PREVIEW_TARGETS = [("Yemoja_Scalp", "Shrinkwrap")]
_PREVIEW_HIDE    = ["Yemoja_Tattoos"]

def preview_mode(on=True):
    changed = []
    for obj_name, mod_name in _PREVIEW_TARGETS:
        ob = bpy.data.objects.get(obj_name)
        if not ob: continue
        m = ob.modifiers.get(mod_name)
        if not m: continue
        m.show_viewport = not on; m.show_render = not on
        changed.append("%s/%s -> %s" % (obj_name, mod_name, "off" if on else "on"))
    for nm in _PREVIEW_HIDE:
        ob = bpy.data.objects.get(nm)
        if ob:
            ob.hide_viewport = on; ob.hide_render = on
            changed.append("%s hidden=%s" % (nm, on))
    bpy.context.view_layer.update()
    return changed


# ------------------------------------------------------------- measurement ---
def lowest_world_z(objnames=("Yemoja_Body",)):
    dg = bpy.context.evaluated_depsgraph_get(); lo = 1e9
    for nm in objnames:
        ob = bpy.data.objects.get(nm)
        if not ob: continue
        ev = ob.evaluated_get(dg); me = ev.to_mesh(); mw = ev.matrix_world
        for v in me.vertices:
            z = (mw @ v.co).z
            if z < lo: lo = z
        ev.to_mesh_clear()
    return lo

def plant_feet(tol=1e-4, max_iter=8):
    """Drop or lift the Hips until the lowest body vertex sits on world z=0.
    By measurement, not arithmetic -- the leg chain's effect on height depends
    on every rotation in it."""
    for _ in range(max_iter):
        dz = lowest_world_z()
        if abs(dz) < tol: break
        loc("Hips", 0.0, -dz / 0.01, 0.0)      # world Z = 0.01 * armature-space Y
        bpy.context.view_layer.update()
    return lowest_world_z()

def bone_world(name, which="tail"):
    bpy.context.view_layer.update()
    pb = armature().pose.bones[full(name)]
    return armature().matrix_world @ (pb.tail if which == "tail" else pb.head)


# ------------------------------------------------------- trident (Unity truth) ---
# The trident is not a Blender asset. In Unity it is a direct child of
# mixamorig:Hand.R on Assets/Prefabs/Characters/PlayerPrefabs/Yemoja.prefab with
# a fixed local transform, and an A_Trident capsule collider as its child.
# Mapping solved from three shared bone positions, max error 0.0016 units:
#     Unity hand-local (x,y,z) -> Blender hand-local (-x, y, z) * 414.248
U2B_SCALE = 414.248
def u2b(v):     return Vector((-v[0]*U2B_SCALE, v[1]*U2B_SCALE, v[2]*U2B_SCALE))
def u2b_dir(v): return Vector((-v[0], v[1], v[2]))

TRIDENT_U = {
    # 2026-09-03: was (-0.02168, 0.07914, -0.00303), which gripped 16.8% up the
    # shaft -- butt at thigh height, planted stance unreachable. Moved to 55.6%.
    "origin":  Vector((0.72241,-0.05068,-0.02370)),
    "right":   Vector(( 0.11398, 0.21261, 0.97047)),   # trident local +X (tine spread)
    "up":      Vector(( 0.21261, 0.94898,-0.23287)),   # trident local +Y (thin axis)
    "forward": Vector((-0.97047, 0.23287, 0.06296)),   # trident local +Z (the SHAFT)
}
TRIDENT_OBJ_SCALE = 100.0      # armature object is scale 0.01, so the prop needs x100

def trident_hand_local_matrix():
    x = -u2b_dir(TRIDENT_U["right"])     # the X-flip made the basis left-handed;
    y =  u2b_dir(TRIDENT_U["up"])        # flip one axis back -- tines are
    z =  u2b_dir(TRIDENT_U["forward"])   # symmetric about that plane
    t =  u2b(TRIDENT_U["origin"])
    return Matrix(((x.x, y.x, z.x, t.x), (x.y, y.y, z.y, t.y),
                   (x.z, y.z, z.z, t.z), (0.0, 0.0, 0.0, 1.0))) @ Matrix.Scale(TRIDENT_OBJ_SCALE, 4)

def trident_local_ends(obj_name="Trident"):
    ob = bpy.data.objects[obj_name]
    zs = [v.co.z for v in ob.data.vertices]
    return Vector((0,0,min(zs))), Vector((0,0,max(zs)))

def trident_ends(obj_name="Trident"):
    A = armature()
    W = A.matrix_world @ A.pose.bones[PFX+"Hand.R"].matrix @ trident_hand_local_matrix()
    b, t = trident_local_ends(obj_name)
    return W @ b, W @ t

def attach_trident(obj_name="Trident"):
    ob = bpy.data.objects.get(obj_name)
    if ob is None: return None
    A = armature()
    ob.parent = None; bpy.context.view_layer.update()
    W = A.matrix_world @ A.pose.bones[PFX+"Hand.R"].matrix @ trident_hand_local_matrix()
    ob.matrix_world = W; bpy.context.view_layer.update()
    keep = ob.matrix_world.copy()
    ob.parent = A; ob.parent_type = "BONE"; ob.parent_bone = PFX + "Hand.R"
    ob.matrix_parent_inverse = Matrix.Identity(4)
    bpy.context.view_layer.update()
    ob.matrix_world = keep; bpy.context.view_layer.update()
    return ob

def orient_hand_for_shaft(shaft_arm_dir, hand_y_hint_arm):
    """Rotate Hand.R so the trident's shaft -- a fixed direction in hand-local
    space, defined by Unity -- points along shaft_arm_dir in armature space.
    One DOF is left free (spin about the shaft); it is chosen so the back of the
    hand faces hand_y_hint_arm."""
    A = armature(); pb = A.pose.bones[PFX+"Hand.R"]
    bpy.context.view_layer.update()
    a = u2b_dir(TRIDENT_U["forward"]).normalized()
    b = Vector(shaft_arm_dir).normalized()
    R0 = a.rotation_difference(b).to_matrix()
    y0 = R0 @ Vector((0,1,0)); d = Vector(hand_y_hint_arm)
    yp = y0 - b*y0.dot(b); dp = d - b*d.dot(b); ang = 0.0
    if yp.length > 1e-6 and dp.length > 1e-6:
        yp.normalize(); dp.normalize()
        ang = math.atan2(yp.cross(dp).dot(b), yp.dot(dp))
    R = Matrix.Rotation(ang, 3, b) @ R0
    h = pb.head.copy()
    pb.matrix = Matrix(((R[0][0],R[0][1],R[0][2],h.x), (R[1][0],R[1][1],R[1][2],h.y),
                        (R[2][0],R[2][1],R[2][2],h.z), (0.0,0.0,0.0,1.0)))
    bpy.context.view_layer.update()


# ------------------------------------------------------------- keyframing ---
def get_action(name, fps=30):
    arm = armature()
    bpy.context.scene.render.fps = fps
    if arm.animation_data is None: arm.animation_data_create()
    act = bpy.data.actions.get(name) or bpy.data.actions.new(name)
    act.use_fake_user = True
    arm.animation_data.action = act
    return act

def key_pose(frame, bones=None):
    """Key rotation on every humanoid bone plus location on Hips only. Keying
    the whole set on every extreme keeps the curves aligned -- partial keying is
    how bones drift between poses in ways nobody can find later."""
    arm = armature(); bones = bones or humanoid_bones(arm)
    bpy.context.scene.frame_set(frame)
    for n in bones:
        arm.pose.bones[n].keyframe_insert("rotation_quaternion", frame=frame, group=n)
    arm.pose.bones[PFX+"Hips"].keyframe_insert("location", frame=frame, group=PFX+"Hips")

def set_interpolation(mode="BEZIER", handle="AUTO_CLAMPED"):
    arm = armature()
    if not (arm.animation_data and arm.animation_data.action): return
    for fc in arm.animation_data.action.fcurves:
        for kp in fc.keyframe_points:
            kp.interpolation = mode
            kp.handle_left_type = kp.handle_right_type = handle



"""
Yemoja animation library  --  BlenderTools/YemojaDesignArtifacts/yemoja_anim_lib.py
Everything Yemoja-related lives in YemojaDesignArtifacts; other characters get
their own sibling folder. Renders go to YemojaDesignArtifacts/anim_review.
For Yemoja_WORKING_v112_anim.blend (80 bones, Unity Humanoid target).

Everything in here was MEASURED on this rig, not assumed. See
claude/yemoja-animation-setup.md in the Claude project for the workings.

THE FRAME
---------
The armature DATA is still in FBX Y-up space; the Armature OBJECT carries the
Y-up -> Z-up conversion, scale 0.01, and the z=0 floor fix (Z +0.14324).
Inside armature space:

    +X = her LEFT          +Y = UP          +Z = FORWARD (toward the opponent)

Measured rotation signs:
    Spine/Neck/Head   +X lean forward,  +Y turn to her left,  +Z tilt to her right
    UpLeg   -X = knee lifts forward (hip flexion);  +X = leg swings back
    Leg     +X = knee bends
    Foot    same-axis rotations ADD down a chain, so a flat sole needs
            Foot_X = -(UpLeg_X + Leg_X)
    Arm.L +Z / Arm.R -Z          raise the arm sideways
    ForeArm -X                   elbow curl (both sides, same sign)
    Shoulder.L +Z / Shoulder.R -Z    elevate the clavicle
    Shoulder.L -Y / Shoulder.R +Y    protract it
    finger bones: local +X = curl, local Z = spread, local Y = useless twist

MIRROR RULE (proved algebraically and by measurement): X keeps its sign, Y and Z flip.

HARD RULES (README_animation_guidelines.md)
    * NEVER key hair_grp* -- non-humanoid bones are dropped silently on import.
    * CLAVICLE RULE: arm above shoulder height -> elevate the clavicle by ~1/3 of
      the arm's elevation, or the shoulder cap loses ~22% of its surface area.
      Punches and thrusts need clavicle PROTRACTION too.
    * Author in place. 30 fps. Feet plant on world z = 0.
"""

import bpy, math
from mathutils import Matrix, Vector

ARM_NAME = "Armature"
PFX      = "mixamorig:"
AXES     = {"X": Vector((1.0,0.0,0.0)), "Y": Vector((0.0,1.0,0.0)), "Z": Vector((0.0,0.0,1.0))}


# ----------------------------------------------------------------- basics ---
def armature():
    return bpy.data.objects[ARM_NAME]

def full(name):
    return name if name.startswith(PFX) or name.startswith("hair_") else PFX + name

def humanoid_bones(arm=None):
    """Bones Unity's Humanoid retargeter actually carries."""
    arm = arm or armature()
    out = []
    for pb in arm.pose.bones:
        n = pb.name
        if not n.startswith(PFX):     continue    # hair_grp* -- never key
        if n.endswith("_end"):        continue
        if n.startswith(PFX + "Eye"): continue    # unverified in the humanoid map
        out.append(n)
    return out

def clear_pose():
    for pb in armature().pose.bones:
        pb.matrix_basis = Matrix.Identity(4)
    bpy.context.view_layer.update()

def rot(name, axis, deg):
    """Rotate a bone by deg about an ARMATURE-SPACE axis, on top of whatever it
    is already doing. Order of calls matters -- rotations do not commute."""
    pb = armature().pose.bones[full(name)]
    M  = pb.bone.matrix_local.to_3x3()
    R  = Matrix.Rotation(math.radians(deg), 3, AXES[axis])
    pb.matrix_basis = (M.inverted() @ R @ M).to_4x4() @ pb.matrix_basis

def lrot(name, axis, deg):
    """Rotate about the bone's OWN local axis."""
    pb = armature().pose.bones[full(name)]
    pb.matrix_basis = pb.matrix_basis @ Matrix.Rotation(math.radians(deg), 4, AXES[axis])

def rot_axis(name, vec, deg):
    """Rotate about an arbitrary ARMATURE-SPACE axis vector."""
    pb = armature().pose.bones[full(name)]
    M  = pb.bone.matrix_local.to_3x3()
    R  = Matrix.Rotation(math.radians(deg), 3, Vector(vec).normalized())
    pb.matrix_basis = (M.inverted() @ R @ M).to_4x4() @ pb.matrix_basis

def loc(name, x=0.0, y=0.0, z=0.0):
    """Translate in armature-space units. Only Hips should ever be translated --
    Unity Humanoid ignores translation on every other bone."""
    pb = armature().pose.bones[full(name)]
    M  = pb.bone.matrix_local.to_3x3()
    pb.matrix_basis.translation += M.inverted() @ Vector((x, y, z))


# ------------------------------------------------------------ pose specs ---
# A pose is {bone: [ops]}, ops applied in order: ("X", 20) or ("loc", x, y, z).
def mirror_ops(ops):
    out = []
    for op in ops:
        if   op[0] == "loc": out.append(("loc", -op[1], op[2], op[3]))
        elif op[0] == "X":   out.append(op)
        else:                out.append((op[0], -op[1]))
    return out

def mirror_name(n):
    if n.endswith(".L"): return n[:-2] + ".R"
    if n.endswith(".R"): return n[:-2] + ".L"
    return n

def mirror_pose(pose):
    out = dict(pose)
    for n, ops in pose.items():
        if n.endswith(".L"):
            out.setdefault(mirror_name(n), mirror_ops(ops))
    return out

def apply_pose(pose, reset=True):
    if reset:
        clear_pose()
    for name, ops in pose.items():
        for op in ops:
            if op[0] == "loc": loc(name, op[1], op[2], op[3])
            else:              rot(name, op[0], op[1])
    bpy.context.view_layer.update()


# ------------------------------------------------- deterministic limb posing ---
# A shortest-arc "point the bone at X" leaves the bone's ROLL unconstrained: the
# joint centres land right but the skin corkscrews and the elbow looks like it
# bends sideways. So we CONSTRUCT the orientation instead of rotating into it.
# Measured: for BOTH arms local X is the elbow hinge, and for a correct curl the
# bend-plane normal n = (elbow-shoulder) x (wrist-elbow) is ANTI-parallel to it
# (dot = -0.999). One rule, no per-side special-casing.
def set_bone_orientation(name, ydir, hinge_dir):
    """local Y along the bone, local X along the joint hinge. No leftover twist."""
    pb = armature().pose.bones[full(name)]
    bpy.context.view_layer.update()
    head = pb.head.copy()
    y = Vector(ydir).normalized()
    x = Vector(hinge_dir); x = x - y * x.dot(y)
    if x.length < 1e-6:
        x = y.cross(Vector((0,0,1)))
        if x.length < 1e-6: x = y.cross(Vector((1,0,0)))
    x.normalize(); z = x.cross(y)
    pb.matrix = Matrix(((x.x, y.x, z.x, head.x),
                        (x.y, y.y, z.y, head.y),
                        (x.z, y.z, z.z, head.z),
                        (0.0, 0.0, 0.0, 1.0)))
    bpy.context.view_layer.update()

def limb_ik(b1, b2, target, pole, twist=0.0):
    """Twist-free 2-bone IK. target/pole are ARMATURE-space points. `pole` is
    where the elbow/knee should point -- it is what stops the joint flipping.
    `twist` afterwards rotates b2 about its own axis: for an arm that is real
    forearm pronation, the only twist a human elbow has."""
    A = armature()
    bpy.context.view_layer.update()
    S  = A.pose.bones[full(b1)].head.copy()
    l1 = A.pose.bones[full(b1)].length
    l2 = A.pose.bones[full(b2)].length
    T  = Vector(target); v = T - S; d = v.length
    ok = d <= (l1 + l2) * 0.999
    d  = max(min(d, (l1 + l2) * 0.999), abs(l1 - l2) * 1.001)
    dirv = v.normalized()
    a = (l1*l1 - l2*l2 + d*d) / (2.0 * d)
    h = math.sqrt(max(l1*l1 - a*a, 0.0))
    pv = Vector(pole) - S
    pv = pv - dirv * pv.dot(dirv)
    if pv.length < 1e-6: pv = dirv.cross(Vector((0,1,0)))
    pv.normalize()
    E = S + dirv * a + pv * h
    W = S + dirv * d
    n = (E - S).cross(W - E)
    hinge = (-n).normalized() if n.length > 1e-8 else pv
    set_bone_orientation(b1, E - S, hinge)
    set_bone_orientation(b2, W - E, hinge)
    if twist:
        lrot(b2, "Y", twist); bpy.context.view_layer.update()
    return ok

def w2a(p): return armature().matrix_world.inverted() @ Vector(p)
def a2w(p): return armature().matrix_world @ Vector(p)

def arm_ik(side, wrist_world, elbow_hint_world, twist=0.0):
    return limb_ik("Arm."+side, "ForeArm."+side, w2a(wrist_world), w2a(elbow_hint_world), twist)

def leg_ik(side, ankle_world, knee_hint_world):
    return limb_ik("UpLeg."+side, "Leg."+side, w2a(ankle_world), w2a(knee_hint_world))


# -------------------------------------------------------------- hand shapes ---
FINGERS = ["Thumb", "Index", "Middle", "Ring", "Pinky"]

def hand_shape(side, curl, spread=None, thumb=None):
    """curl: (j1,j2,j3) for every finger, or {finger: (j1,j2,j3)}.
    spread: {finger: degrees} fanning them apart. Unity Humanoid carries finger
    bones, so this survives retargeting."""
    for f in FINGERS:
        c = curl.get(f) if isinstance(curl, dict) else curl
        if f == "Thumb" and thumb is not None: c = thumb
        if c is None: continue
        for j in (1, 2, 3):
            if c[j-1]: lrot("Hand%s%d.%s" % (f, j, side), "X", c[j-1])
        if spread and f in spread:
            lrot("Hand%s1.%s" % (f, side), "Z", spread[f])


"""
Yemoja animation library  --  BlenderTools/yemoja_anim_lib.py
Written for Yemoja_WORKING_v112_anim.blend (80 bones, Unity Humanoid target).

WHY THIS EXISTS
---------------
Mixamo bones have awkward local axes: each bone's local Y runs along the bone,
so "rotate the arm 30 degrees" means a different Euler triple for every bone.
Authoring that way is guesswork and does not survive review.

Instead every function here takes a rotation expressed in ARMATURE SPACE and
converts it into the bone's local space with  B = Minv * R * M  (M = the bone's
rest matrix). You always think in one fixed, human-readable frame.

THE FRAME (verified empirically on this rig, 2026-09-02)
-------------------------------------------------------
The armature DATA is still in FBX Y-up space; the Armature OBJECT carries the
Y-up -> Z-up conversion plus scale 0.01 plus the z=0 floor fix (Z +0.14324).
So inside armature space:

    +X = her LEFT          +Y = UP          +Z = FORWARD (toward the opponent)

Rotation signs, all measured, not assumed:

    Spine/Neck/Head   +X = lean FORWARD        -X = arch BACK
                      +Y = turn to her LEFT    -Y = turn to her RIGHT
                      +Z = tilt to her RIGHT   -Z = tilt to her LEFT
    UpLeg  -X = knee lifts FORWARD (hip flexion),  +X = leg swings BACK
    Leg    +X = knee BENDS (heel travels back)
    Foot   armature-space rotations ADD down a chain when they share an axis,
           so to keep a sole flat:  Foot_X = -(UpLeg_X + Leg_X)
    Arm.L  +Z raises the arm sideways;   Arm.R  -Z does the same. (mirror)
    ForeArm.L  -X = elbow curl;          ForeArm.R  -X = elbow curl. (same sign)
    Shoulder.L +Z elevates the clavicle; Shoulder.R -Z elevates it.
    Shoulder.L -Y protracts (slides fwd); Shoulder.R +Y protracts.

MIRROR RULE (proved both algebraically and by measurement):
    X keeps its sign, Y and Z flip sign.

HARD RULES FROM README_animation_guidelines.md
----------------------------------------------
* NEVER key hair_grp* -- non-humanoid bones are silently dropped on Unity import.
* CLAVICLE RULE: any time the arm rises above shoulder height, elevate the
  clavicle by ~1/3 of the arm's elevation, or the shoulder cap loses ~22% of
  its surface area. Punches and thrusts need clavicle PROTRACTION as well.
* Author in place -- the game drives movement through CharacterPhysics.
* 30 fps. Feet plant on world z = 0.
"""

import bpy, math, json
from mathutils import Matrix, Vector

ARM_NAME = "Armature"
PFX      = "mixamorig:"
AXES     = {"X": Vector((1.0, 0.0, 0.0)),
            "Y": Vector((0.0, 1.0, 0.0)),
            "Z": Vector((0.0, 0.0, 1.0))}

# Bones Unity's Humanoid retargeter will actually carry. Everything else is
# either a silently-dropped non-humanoid bone or a pointless leaf.
def humanoid_bones(arm=None):
    arm = arm or armature()
    out = []
    for pb in arm.pose.bones:
        n = pb.name
        if not n.startswith(PFX):      continue   # hair_grp* -- never key
        if n.endswith("_end"):         continue   # leaf tips, nothing deforms
        if n.startswith(PFX + "Eye"):  continue   # unverified in humanoid map
        out.append(n)
    return out


# ----------------------------------------------------------------- basics ---
def armature():
    return bpy.data.objects[ARM_NAME]

def full(name):
    """'Arm.L' -> 'mixamorig:Arm.L'. Pass-through if already prefixed."""
    return name if name.startswith(PFX) or name.startswith("hair_") else PFX + name

def clear_pose():
    for pb in armature().pose.bones:
        pb.matrix_basis = Matrix.Identity(4)
    bpy.context.view_layer.update()

def rot(name, axis, deg):
    """Rotate a bone by `deg` about an ARMATURE-SPACE axis, on top of whatever
    the bone is already doing. Order of calls matters (rotations don't commute)."""
    pb = armature().pose.bones[full(name)]
    M  = pb.bone.matrix_local.to_3x3()
    R  = Matrix.Rotation(math.radians(deg), 3, AXES[axis])
    pb.matrix_basis = (M.inverted() @ R @ M).to_4x4() @ pb.matrix_basis

def loc(name, x=0.0, y=0.0, z=0.0):
    """Translate a bone in armature-space units (+Y up, +Z forward, +X her left).
    In practice only Hips should ever be translated -- Unity Humanoid ignores
    translation on every other bone."""
    pb = armature().pose.bones[full(name)]
    M  = pb.bone.matrix_local.to_3x3()
    pb.matrix_basis.translation += M.inverted() @ Vector((x, y, z))


# ------------------------------------------------------------ pose specs ---
# A pose is a dict: bone name -> list of ops applied in order.
#   ("X", 20)          rotate 20 deg about armature X
#   ("loc", x, y, z)   translate (Hips only)
# Suffix a bone name with ".L" and mirror_pose() will build the ".R" twin.

def mirror_ops(ops):
    """X keeps its sign; Y and Z flip. Translations flip in X."""
    out = []
    for op in ops:
        if op[0] == "loc":
            out.append(("loc", -op[1], op[2], op[3]))
        elif op[0] == "X":
            out.append(op)
        else:
            out.append((op[0], -op[1]))
    return out

def mirror_name(n):
    if n.endswith(".L"): return n[:-2] + ".R"
    if n.endswith(".R"): return n[:-2] + ".L"
    return n

def mirror_pose(pose):
    """Return a new pose with every .L entry copied to its .R twin."""
    out = dict(pose)
    for n, ops in pose.items():
        if n.endswith(".L"):
            out.setdefault(mirror_name(n), mirror_ops(ops))
    return out

def apply_pose(pose, reset=True):
    if reset:
        clear_pose()
    for name, ops in pose.items():
        for op in ops:
            if op[0] == "loc":
                loc(name, op[1], op[2], op[3])
            else:
                rot(name, op[0], op[1])
    bpy.context.view_layer.update()


# ------------------------------------------------------------- keyframing ---
def get_action(name, fps=30):
    arm = armature()
    bpy.context.scene.render.fps = fps
    if arm.animation_data is None:
        arm.animation_data_create()
    act = bpy.data.actions.get(name) or bpy.data.actions.new(name)
    act.use_fake_user = True          # survives a save with no user
    arm.animation_data.action = act
    return act

def key_pose(frame, bones=None):
    """Key rotation on every humanoid bone, plus location on Hips only.
    Keying the whole set on every extreme keeps the curves aligned -- partial
    keying is how you get bones drifting between poses in ways nobody can find."""
    arm   = armature()
    bones = bones or humanoid_bones(arm)
    bpy.context.scene.frame_set(frame)
    for n in bones:
        pb = arm.pose.bones[n]
        pb.keyframe_insert("rotation_quaternion", frame=frame, group=n)
    arm.pose.bones[PFX + "Hips"].keyframe_insert("location", frame=frame,
                                                 group=PFX + "Hips")

def set_interpolation(mode="BEZIER", handle="AUTO_CLAMPED"):
    arm = armature()
    if not (arm.animation_data and arm.animation_data.action):
        return
    for fc in arm.animation_data.action.fcurves:
        for kp in fc.keyframe_points:
            kp.interpolation = mode
            kp.handle_left_type = kp.handle_right_type = handle


# ------------------------------------------------------- measurement ------
def lowest_world_z(objnames=("Yemoja_Body",)):
    """Lowest evaluated world-space Z. This is the floor check -- her soles are
    supposed to sit at 0.0 exactly (rule 225)."""
    dg = bpy.context.evaluated_depsgraph_get()
    lo = 1e9
    for nm in objnames:
        ob = bpy.data.objects.get(nm)
        if not ob:
            continue
        ev = ob.evaluated_get(dg)
        me = ev.to_mesh()
        mw = ev.matrix_world
        for v in me.vertices:
            z = (mw @ v.co).z
            if z < lo:
                lo = z
        ev.to_mesh_clear()
    return lo

def plant_feet(tol=1e-4, max_iter=8):
    """Drop or lift the Hips until the lowest body vertex sits on world z=0.
    Done by measurement, not arithmetic, because the leg chain's effect on
    height depends on every rotation in it."""
    hips = armature().pose.bones[PFX + "Hips"]
    for _ in range(max_iter):
        dz = lowest_world_z()
        if abs(dz) < tol:
            break
        # world Z = 0.01 * armature-space Y, so convert before moving.
        loc("Hips", 0.0, -dz / 0.01, 0.0)
        bpy.context.view_layer.update()
    return lowest_world_z()

def bone_world(name, which="tail"):
    bpy.context.view_layer.update()
    pb = armature().pose.bones[full(name)]
    return armature().matrix_world @ (pb.tail if which == "tail" else pb.head)


# ------------------------------------------------------------- rendering ---
def viewport_render(path, camera=None, res=(900, 1200), samples=None):
    sc = bpy.context.scene
    if camera:
        sc.camera = bpy.data.objects[camera]
    sc.render.resolution_x, sc.render.resolution_y = res
    sc.render.resolution_percentage = 100
    sc.render.filepath = path
    sc.render.image_settings.file_format = "PNG"
    bpy.ops.render.opengl(write_still=True)
    return path


# --------------------------------------------------------- local rotations ---
# Some joints are only sane in their own local frame. Measured on this rig:
#   finger bones:  local +X = CURL toward the palm (both hands)
#                  local  Y = twist along the bone (useless, ~0 tip movement)
#                  local  Z = SPREAD sideways
#   ForeArm:       local Y = pronation/supination twist
def lrot(name, axis, deg):
    """Rotate about the bone's OWN local axis, post-multiplied."""
    pb = armature().pose.bones[full(name)]
    ax = {"X": Vector((1,0,0)), "Y": Vector((0,1,0)), "Z": Vector((0,0,1))}[axis]
    pb.matrix_basis = pb.matrix_basis @ Matrix.Rotation(math.radians(deg), 4, ax)

def rot_axis(name, vec, deg):
    """Rotate about an arbitrary ARMATURE-SPACE axis vector."""
    pb = armature().pose.bones[full(name)]
    M  = pb.bone.matrix_local.to_3x3()
    R  = Matrix.Rotation(math.radians(deg), 3, Vector(vec).normalized())
    pb.matrix_basis = (M.inverted() @ R @ M).to_4x4() @ pb.matrix_basis


# -------------------------------------------------------------- hand shapes ---
FINGERS = ["Thumb", "Index", "Middle", "Ring", "Pinky"]

def hand_shape(side, curl, spread=None, thumb=None):
    """curl:   (j1, j2, j3) degrees of curl applied to every finger, OR a dict
                finger -> (j1, j2, j3) for per-finger control.
       spread: dict finger -> degrees about local Z (fan the fingers apart).
       thumb:  (j1, j2, j3) override for the thumb, which reads badly if it
               curls like the others.
    Unity Humanoid does carry finger bones, so this survives retargeting."""
    for f in FINGERS:
        c = curl.get(f) if isinstance(curl, dict) else curl
        if f == "Thumb" and thumb is not None:
            c = thumb
        if c is None:
            continue
        for j in (1, 2, 3):
            deg = c[j-1]
            if deg:
                lrot("Hand%s%d.%s" % (f, j, side), "X", deg)
        if spread and f in spread:
            lrot("Hand%s1.%s" % (f, side), "Z", spread[f])

# Two reusable shapes for Yemoja.
OPEN_WATER_HAND = dict(curl=(14, 20, 16),
                       thumb=(10, 8, 6),
                       spread={"Index": 8, "Middle": 2, "Ring": -5, "Pinky": -11})
COILED_HAND     = dict(curl=(52, 78, 58),
                       thumb=(18, 26, 14),
                       spread={"Index": 2, "Middle": 0, "Ring": -2, "Pinky": -5})


# ------------------------------------------------------------ aiming / IK ---
# Posing a limb by guessing three Euler angles per bone does not scale. These
# let you say "put the hand HERE" instead, which is how you actually art-direct
# a fighting pose: you place the contact point, the machine finds the joint.

def w2a(p):
    """World-space point -> armature-space point."""
    return armature().matrix_world.inverted() @ Vector(p)

def a2w(p):
    return armature().matrix_world @ Vector(p)

def aim_bone(name, target, roll=0.0):
    """Rotate the bone (armature space) so its tail points at `target`
    (armature-space point). `roll` then twists about the bone's own axis."""
    pb = armature().pose.bones[full(name)]
    bpy.context.view_layer.update()
    cur = (pb.tail - pb.head)
    des = (Vector(target) - pb.head)
    if cur.length < 1e-9 or des.length < 1e-9:
        return
    q = cur.rotation_difference(des)
    axis, ang = q.to_axis_angle()
    if abs(ang) > 1e-9:
        rot_axis(name, axis, math.degrees(ang))
    if roll:
        lrot(name, "Y", roll)
    bpy.context.view_layer.update()

def two_bone_ik(b1, b2, target, pole, roll=0.0):
    """Analytic 2-bone IK (upper arm + forearm, or thigh + shin).
    target: armature-space point for the END of b2.
    pole:   armature-space point the JOINT (elbow/knee) should point toward.
            This is what stops the elbow flipping about randomly -- the elbow
            lands on the plane through the limb containing the pole.
    Returns True if the target was reachable, False if it had to be clamped."""
    A = armature()
    bpy.context.view_layer.update()
    p  = A.pose.bones[full(b1)].head.copy()
    l1 = A.pose.bones[full(b1)].length
    l2 = A.pose.bones[full(b2)].length
    t  = Vector(target)
    v  = t - p
    d  = v.length
    ok = d <= (l1 + l2) * 0.999
    d  = min(d, (l1 + l2) * 0.999)
    d  = max(d, abs(l1 - l2) * 1.001)
    dirv = v.normalized()
    a  = (l1*l1 - l2*l2 + d*d) / (2.0 * d)
    h  = math.sqrt(max(l1*l1 - a*a, 0.0))
    pv = Vector(pole) - p
    pv = pv - dirv * pv.dot(dirv)
    if pv.length < 1e-6:                       # degenerate pole, pick any normal
        pv = dirv.cross(Vector((0, 1, 0)))
    pv.normalize()
    elbow = p + dirv * a + pv * h
    aim_bone(b1, elbow)
    aim_bone(b2, p + dirv * d, roll)
    return ok

def hand_to(side, target_world, elbow_world, roll=0.0):
    """Place a hand: give the WRIST a world-space target and say roughly where
    the elbow should live. Signs and mirroring are handled for you."""
    return two_bone_ik("Arm." + side, "ForeArm." + side,
                       w2a(target_world), w2a(elbow_world), roll)

def foot_to(side, target_world, knee_world):
    return two_bone_ik("UpLeg." + side, "Leg." + side,
                       w2a(target_world), w2a(knee_world))



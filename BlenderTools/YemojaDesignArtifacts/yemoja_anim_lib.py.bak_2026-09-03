# ------------------------------------------------------- trident (Unity truth) ---
# The trident is NOT a Blender asset. In Unity it is a direct child of
# mixamorig:Hand.R on Assets/Prefabs/Characters/PlayerPrefabs/Yemoja.prefab, with a
# fixed local transform. That transform -- not anything posed by eye in Blender --
# is what the player sees, so the Blender preview reproduces it exactly.
#
# Mapping solved from three shared bone positions (max error 0.0016 armature units):
#     Unity hand-local (x,y,z)  ->  Blender hand-local (-x, y, z) * 414.248
# i.e. a single X flip (Unity is left-handed) plus the units scale.
U2B_SCALE = 414.248
def u2b(v):   return Vector((-v[0] * U2B_SCALE, v[1] * U2B_SCALE, v[2] * U2B_SCALE))
def u2b_dir(v): return Vector((-v[0], v[1], v[2]))

# Values read straight off the Unity prefab.
TRIDENT_U = {
    "origin":  Vector((-0.02168, 0.07914, -0.00303)),   # localPosition in hand space
    "right":   Vector(( 0.11398, 0.21261,  0.97047)),   # trident local +X (tine spread)
    "up":      Vector(( 0.21261, 0.94898, -0.23287)),   # trident local +Y (thin axis)
    "forward": Vector((-0.97047, 0.23287,  0.06296)),   # trident local +Z (the SHAFT)
    "butt_z":  -0.0036,   # mesh bounds, trident-local Z
    "tip_z":    0.0158,
}
TRIDENT_OBJ_SCALE = 100.0   # armature object is scale 0.01, so the prop needs x100

def trident_hand_local_matrix():
    """The trident's placement inside Hand.R's local frame, Blender side."""
    x = u2b_dir(TRIDENT_U["right"]); y = u2b_dir(TRIDENT_U["up"]); z = u2b_dir(TRIDENT_U["forward"])
    x = -x                      # flip one axis: the X-flip made the basis left-handed,
                                # and the tines are symmetric about that plane
    t = u2b(TRIDENT_U["origin"])
    R = Matrix(((x.x, y.x, z.x, t.x),
                (x.y, y.y, z.y, t.y),
                (x.z, y.z, z.z, t.z),
                (0.0, 0.0, 0.0, 1.0)))
    return R @ Matrix.Scale(TRIDENT_OBJ_SCALE, 4)

def attach_trident(obj_name="Trident"):
    """Snap the preview trident onto the hand at Unity's exact offset and
    bone-parent it, so it tracks the hand for the rest of the session."""
    ob = bpy.data.objects.get(obj_name)
    if ob is None: return None
    A = armature()
    ob.parent = None
    bpy.context.view_layer.update()
    hand = A.pose.bones[PFX + "Hand.R"]
    W = A.matrix_world @ hand.matrix @ trident_hand_local_matrix()
    ob.matrix_world = W
    bpy.context.view_layer.update()
    keep = ob.matrix_world.copy()
    ob.parent = A; ob.parent_type = "BONE"; ob.parent_bone = PFX + "Hand.R"
    ob.matrix_parent_inverse = Matrix.Identity(4)
    bpy.context.view_layer.update()
    ob.matrix_world = keep
    bpy.context.view_layer.update()
    return ob

def trident_local_ends(obj_name="Trident"):
    """Butt and tip in the prop's OWN local coords, read from the mesh rather
    than from rounded Unity bounds."""
    ob = bpy.data.objects[obj_name]
    zs = [v.co.z for v in ob.data.vertices]
    return Vector((0, 0, min(zs))), Vector((0, 0, max(zs)))

def trident_ends(obj_name="Trident"):
    """World-space butt and tip of the preview trident, for the current pose."""
    A = armature()
    W = A.matrix_world @ A.pose.bones[PFX + "Hand.R"].matrix @ trident_hand_local_matrix()
    b, t = trident_local_ends(obj_name)
    return W @ b, W @ t

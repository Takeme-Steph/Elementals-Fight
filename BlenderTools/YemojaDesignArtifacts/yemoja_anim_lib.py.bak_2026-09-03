def review(tag, cams=("front", "side", "q34"), silhouette=True,
           out=r"C:\Users\steph\Documents\Elementals-Fight\BlenderTools\_anim_review"):
    """Clay + silhouette renders of the current pose.
    The silhouette pass is not decoration: a fighting pose that does not read as
    a solid black shape at thumbnail size will not read on a phone mid-fight."""
    import os
    os.makedirs(out, exist_ok=True)
    sc = bpy.context.scene
    sav = dict(engine=sc.render.engine, cam=sc.camera, rx=sc.render.resolution_x,
               ry=sc.render.resolution_y, fp=sc.render.filepath)
    sh  = sc.display.shading
    shs = (sh.light, sh.color_type, tuple(sh.single_color), sh.show_cavity)
    lc  = bpy.context.view_layer.layer_collection.children.get("Yemoja")
    src = lc.children.get("Yemoja_Source") if lc else None
    if src: src.exclude = True
    sc.render.engine = "BLENDER_WORKBENCH"
    paths = []
    sh.light="STUDIO"; sh.color_type="SINGLE"; sh.single_color=(0.62,0.63,0.66); sh.show_cavity=True
    sc.render.resolution_x, sc.render.resolution_y = 800, 1100
    for n in cams:
        sc.camera = bpy.data.objects["_AR_" + n]
        p = os.path.join(out, "%s_%s.png" % (tag, n)); sc.render.filepath = p
        bpy.ops.render.render(write_still=True); paths.append(p)
    if silhouette:
        sh.light="FLAT"; sh.color_type="SINGLE"; sh.single_color=(0,0,0); sh.show_cavity=False
        sc.render.resolution_x, sc.render.resolution_y = 300, 412
        for n in cams:
            sc.camera = bpy.data.objects["_AR_" + n]
            p = os.path.join(out, "%s_sil_%s.png" % (tag, n)); sc.render.filepath = p
            bpy.ops.render.render(write_still=True); paths.append(p)
    sh.light, sh.color_type, sh.single_color, sh.show_cavity = shs
    if src: src.exclude = False
    sc.render.engine=sav["engine"]; sc.camera=sav["cam"]
    sc.render.resolution_x, sc.render.resolution_y = sav["rx"], sav["ry"]
    sc.render.filepath = sav["fp"]
    return paths


# ----------------------------------------------------- animation preview mode ---
# Yemoja_Scalp and Yemoja_Tattoos each carry a Shrinkwrap that sits BEFORE their
# Armature modifier and targets the EVALUATED Yemoja_Body. In rest pose that is
# correct. The moment she is posed, the scalp/decal is still in rest space but
# is being projected onto a body that has moved, so the locs are rebuilt from
# the wrong surface -- measured at -23% total loc length on a fight stance.
#
# This is a VIEWPORT artifact only: the export sequence applies both modifiers
# in rest pose (README_unity_import.md section 10), so the FBX Unity receives
# has the locs baked as real geometry and is unaffected.
#
# But you cannot judge a pose from a render that is lying, so turn them off
# while animating and back on before export prep.
_PREVIEW_TARGETS = [("Yemoja_Scalp", "Shrinkwrap")]
_PREVIEW_HIDE   = ["Yemoja_Tattoos"]

def preview_mode(on=True):
    """on=True  -> disable the rest-space shrinkwraps: locs and decals keep
                   their authored shape and simply ride the skeleton.
       on=False -> restore them (do this before the export prep sequence)."""
    changed = []
    for obj_name, mod_name in _PREVIEW_TARGETS:
        ob = bpy.data.objects.get(obj_name)
        if not ob: continue
        m = ob.modifiers.get(mod_name)
        if not m: continue
        m.show_viewport = not on
        m.show_render   = not on
        changed.append("%s/%s -> %s" % (obj_name, mod_name, "off" if on else "on"))
    for nm in _PREVIEW_HIDE:
        ob = bpy.data.objects.get(nm)
        if ob:
            ob.hide_viewport = on; ob.hide_render = on
            changed.append("%s hidden=%s" % (nm, on))
    bpy.context.view_layer.update()
    return changed


# ------------------------------------------------- deterministic limb posing ---
# aim_bone() uses a shortest-arc rotation, which leaves the bone's ROLL
# unconstrained. The joint centres land correctly but the skin corkscrews --
# a bicep that twists like a rope, an elbow that appears to bend sideways.
#
# The fix is to stop rotating and start CONSTRUCTING the orientation. Measured
# on this rig: for BOTH arms, local X is the elbow hinge axis, and for a correct
# curl the bend-plane normal n = (elbow-shoulder) x (wrist-elbow) is ANTI-parallel
# to it (dot = -0.999). So the hinge direction is always -n. One rule, no
# special-casing per side.
HINGE_LOCAL_AXIS = "X"

def set_bone_orientation(name, ydir, hinge_dir):
    """Build the bone's armature-space orientation outright: local Y along the
    bone, local X along the joint hinge. No leftover twist to go wrong."""
    pb = armature().pose.bones[full(name)]
    bpy.context.view_layer.update()
    head = pb.head.copy()
    y = Vector(ydir).normalized()
    x = Vector(hinge_dir)
    x = x - y * x.dot(y)
    if x.length < 1e-6:
        x = y.cross(Vector((0, 0, 1)))
        if x.length < 1e-6:
            x = y.cross(Vector((1, 0, 0)))
    x.normalize()
    z = x.cross(y)
    pb.matrix = Matrix(((x.x, y.x, z.x, head.x),
                        (x.y, y.y, z.y, head.y),
                        (x.z, y.z, z.z, head.z),
                        (0.0, 0.0, 0.0, 1.0)))
    bpy.context.view_layer.update()

def limb_ik(b1, b2, target, pole, twist=0.0):
    """Twist-free 2-bone IK. target/pole are ARMATURE-space points.
    `twist` afterwards rotates b2 about its own axis -- for an arm that is real
    forearm pronation/supination, which is the only twist a human elbow has."""
    A = armature()
    bpy.context.view_layer.update()
    S  = A.pose.bones[full(b1)].head.copy()
    l1 = A.pose.bones[full(b1)].length
    l2 = A.pose.bones[full(b2)].length
    T  = Vector(target)
    v  = T - S
    d  = v.length
    ok = d <= (l1 + l2) * 0.999
    d  = max(min(d, (l1 + l2) * 0.999), abs(l1 - l2) * 1.001)
    dirv = v.normalized()
    a = (l1*l1 - l2*l2 + d*d) / (2.0 * d)
    h = math.sqrt(max(l1*l1 - a*a, 0.0))
    pv = Vector(pole) - S
    pv = pv - dirv * pv.dot(dirv)
    if pv.length < 1e-6:
        pv = dirv.cross(Vector((0, 1, 0)))
    pv.normalize()
    E = S + dirv * a + pv * h
    W = S + dirv * d
    n = (E - S).cross(W - E)
    hinge = (-n).normalized() if n.length > 1e-8 else pv
    set_bone_orientation(b1, E - S, hinge)
    set_bone_orientation(b2, W - E, hinge)
    if twist:
        lrot(b2, "Y", twist)
        bpy.context.view_layer.update()
    return ok

def arm_ik(side, wrist_world, elbow_hint_world, twist=0.0):
    return limb_ik("Arm." + side, "ForeArm." + side,
                   w2a(wrist_world), w2a(elbow_hint_world), twist)

def leg_ik(side, ankle_world, knee_hint_world):
    return limb_ik("UpLeg." + side, "Leg." + side,
                   w2a(ankle_world), w2a(knee_hint_world))

